AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=
# Local development only. Hosted deployments must set false and supply an analyst token.
PITCHGUARD_LOCAL_ONLY=true
PITCHGUARD_ANALYST_TOKEN=
PITCHGUARD_DAILY_CALL_LIMIT=60
PITCHGUARD_DAILY_TOKEN_LIMIT=300000
PITCHGUARD_DAILY_CASE_LIMIT=16
# Optional verified USD rates per million tokens; blank means cost unknown.
PITCHGUARD_INPUT_USD_PER_MILLION=
PITCHGUARD_OUTPUT_USD_PER_MILLION=
