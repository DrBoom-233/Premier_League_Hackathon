digraph History { graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.48", fontname="Arial", fontsize=18];
node [shape=box, style="rounded,filled", fillcolor="#eef5ff", color="#7697c3", fontname="Arial", fontsize=18, margin="0.24,0.17", penwidth=1.3];
edge [color="#536780", fontname="Arial", fontsize=15, arrowsize=0.8, penwidth=1.3];
  source [label="Daily records
and injury history"];
  cutoff [label="Select player and cutoff
Past information only"];
  quality [label="Field whitelist
and missing-data checks"];
  features [label="Complete 7 / 28-day windows
Workload, exposure and recovery"];
  agent [label="Historical Analyst Agent
Interpret computed features",fillcolor="#dbeafe"];
  observations [label="Cited observations
and limitations"];
  investigation [label="Evidence Investigator",fillcolor="#e5f4ed"];
  dashboard [label="History Analyst panel
Dated source records",fillcolor="#e5f4ed"];
  predictor [label="PLANNED: historical predictor
P(I | H)
Train, evaluate and calibrate",style="rounded,dashed,filled",fillcolor="#fff5df",color="#b88b35"];
  source -> cutoff -> quality -> features -> agent -> observations;
  observations -> investigation;
  observations -> dashboard;
  features -> predictor [style=dashed,label="Future tool"];
  predictor -> agent [style=dashed];
  {rank=same; agent; predictor;}
  {rank=same; investigation; dashboard;}
}