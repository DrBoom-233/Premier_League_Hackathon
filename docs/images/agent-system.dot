digraph System { graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.48", fontname="Arial", fontsize=18];
node [shape=box, style="rounded,filled", fillcolor="#eef5ff", color="#7697c3", fontname="Arial", fontsize=18, margin="0.24,0.17", penwidth=1.3];
edge [color="#536780", fontname="Arial", fontsize=15, arrowsize=0.8, penwidth=1.3];
  history [label="Player history
Workload and recovery"];
  frames [label="Replay and reference
Timestamped frames"];
  historical [label="Historical Analyst Agent",fillcolor="#dbeafe"];
  motion [label="Motion Analyst Agent",fillcolor="#dbeafe"];
  investigator [label="Evidence Investigator
Identity, timing and citations",fillcolor="#dbeafe"];
  analyst [label="Analyst dashboard
Evidence and limitations",fillcolor="#e5f4ed"];
  narrative [label="Match Narrative Agent
Public visual facts",fillcolor="#dbeafe"];
  fan [label="Fan explanation",fillcolor="#e5f4ed"];
  history -> historical;
  frames -> motion;
  {rank=same; history; frames;}
  {rank=same; historical; motion;}
  historical -> investigator;
  motion -> investigator;
  investigator -> motion [style=dashed, label="One focused recheck",constraint=false];
  investigator -> analyst;
  investigator -> narrative;
  narrative -> fan;
  {rank=same; analyst; narrative;}
}